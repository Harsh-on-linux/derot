{
  "manifest_version": 3,
  "name": "Derot — Minimal YouTube",
  "version": "0.1.0",
  "description": "Zero-distraction YouTube: no Shorts, no feeds, no recommendations. Search and watch only.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_title": "Derot",
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "icons": { "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
